#!/usr/bin/env bash
# chat-message — observe user follow-ups; recording is handled by
# traces-sync.py from the Shelley DB at end-of-turn (full typing incl.
# thinking + tool calls). We only pass the message through unchanged.
# stdin JSON: { message, readonly: { conversation_id, model, ... } }
# stdout: { "message": "..." } (unchanged)
set -euo pipefail

INPUT="$(cat)"
# Echo the message back unchanged so Shelley proceeds normally.
printf '%s' "$INPUT" | jq -c '{message: .message}'
