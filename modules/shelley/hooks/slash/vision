#!/bin/bash
# /vision slash command for Shelley.
# Usage:  /vision <image path or URL> [question]
#
# Reads stdin JSON {command, args, raw_message, cwd, ...} and rewrites the
# user message into a VISION-tool instruction, so the agent runs the side-call
# and summarizes the transcription for you.
set -euo pipefail

input=$(cat)
args=$(printf '%s' "$input" | jq -r '.args // empty')
[ -z "$args" ] && { echo "Usage: /vision <image path|URL> [question]"; exit 0; }

# Locate vision: PATH first, then the dotfiles location (bash login shells
# may not have ~/dotfiles/bin on PATH).
if command -v vision >/dev/null 2>&1; then
  cmd="vision"
else
  for c in "$HOME/dotfiles/bin/vision" /home/exedev/dotfiles/bin/vision; do
    [ -x "$c" ] && cmd="$c" && break
  done
fi
[ -z "${cmd:-}" ] && { echo "vision CLI not found — is ~/dotfiles/bin/vision installed?"; exit 0; }

printf '[VISION request]\n%s\n\nRun `%s %s` (add --json if you want structured output) and summarize the transcription for me. If the call fails, report the failure reason and continue.' "$args" "$cmd" "$args"
