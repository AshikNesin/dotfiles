#!/bin/bash
# /vision slash command for Shelley.
# Usage:  /vision <image path or URL> [question]
#
# Reads stdin JSON {command, args, raw_message, cwd, ...} and rewrites the
# user message into a VISION-tool instruction, so the agent runs the side-call
# and summarizes the transcription for you.
set -euo pipefail

input=$(cat)
args=$(printf '%s' "$input" | jq -r '.args // empty')
[ -z "$args" ] && { echo "Usage: /vision <image path|URL> [question]"; exit 0; }

printf '[VISION request]\n%s\n\nRun `vision %s` (add --json if you want structured output) and summarize the transcription for me. If the call fails, report the failure reason and continue.' "$args" "$args"
